GITHUB_APP_ID=
GITHUB_PRIVATE_KEY_PATH=./private-key.pem
GITHUB_WEBHOOK_SECRET=
AZURE_API_KEY=
AZURE_API_BASE=https://your-resource.openai.azure.com
AZURE_API_VERSION=2024-02-15-preview
REVIEW_MODEL=azure/your-deployment-name
FALKORDB_HOST=falkordb
FALKORDB_PORT=6379
# Per-installation FalkorDB (multi-tenant). When true, each GitHub App
# installation gets its own FalkorDB container provisioned on app install.
# Requires the app to have access to the Docker daemon (see docker-compose.yml).
GRAPHORA_PER_INSTALL_DB=false
FALKORDB_IMAGE=falkordb/falkordb:latest
# Docker network the per-installation containers join (optional). When the app
# itself runs in Docker, set this to a shared network so it can reach them.
GRAPHORA_INSTANCE_NETWORK=
# Host/address the app uses to reach per-installation FalkorDB containers.
GRAPHORA_INSTANCE_HOST=127.0.0.1
S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
GRAPHREVIEW_BOT_LOGIN=graphreview
